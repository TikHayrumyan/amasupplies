// use prisma-next

model Hero {
  id          Int         @id @default(autoincrement())
  title       String      @default("")
  description String      @default("")
  imageUrl    String?
  videoUrl    String?
  updatedAt   Timestamptz @default(now())

  @@rls
  @@map("hero")
}

model Category {
  id          Int         @id @default(autoincrement())
  title       String
  slug        String      @unique
  description String      @default("")
  imageUrl    String
  sortOrder   Float       @default(0)
  isPublished Boolean     @default(true)
  updatedAt   Timestamptz @default(now())

  @@rls
  @@map("category")
}

model Brand {
  id          Int         @id @default(autoincrement())
  title       String
  imageUrl    String
  sortOrder   Float       @default(0)
  isPublished Boolean     @default(true)
  updatedAt   Timestamptz @default(now())

  @@rls
  @@map("brand")
}
