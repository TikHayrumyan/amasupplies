// use prisma-next

model Hero {
  id          Int         @id @default(autoincrement())
  title       String      @default("")
  description String      @default("")
  imageUrl    String?
  videoUrl    String?
  updatedAt   Timestamptz @default(now())

  @@rls
  @@map("hero")
}

model Category {
  id          Int         @id @default(autoincrement())
  title       String
  slug        String      @unique
  description String      @default("")
  imageUrl    String
  sortOrder   Float       @default(0)
  isPublished Boolean     @default(true)
  updatedAt   Timestamptz @default(now())

  @@rls
  @@map("category")
}

model Brand {
  id          Int         @id @default(autoincrement())
  title       String
  imageUrl    String
  sortOrder   Float       @default(0)
  isPublished Boolean     @default(true)
  updatedAt   Timestamptz @default(now())

  @@rls
  @@map("brand")
}

model Size {
  id        Int         @id @default(autoincrement())
  title     String      @unique
  slug      String      @unique
  sortOrder Float       @default(0)
  updatedAt Timestamptz @default(now())

  @@rls
  @@map("size")
}

model ProductBrand {
  id        Int         @id @default(autoincrement())
  title     String      @unique
  slug      String      @unique
  sortOrder Float       @default(0)
  updatedAt Timestamptz @default(now())

  @@rls
  @@map("product_brand")
}

model ProductType {
  id         Int         @id @default(autoincrement())
  categoryId Int
  title      String
  slug       String
  sortOrder  Float       @default(0)
  updatedAt  Timestamptz @default(now())

  @@unique([categoryId, slug])
  @@unique([categoryId, title])
  @@rls
  @@map("product_type")
}

model Product {
  id              Int         @id @default(autoincrement())
  title           String
  slug            String      @unique
  metaTitle       String      @default("")
  metaDescription String      @default("")
  description     String      @default("")
  imageUrl        String
  sku             String      @unique
  itemNumber      String      @unique
  brandId         Int
  categoryId      Int
  typeId          Int?
  sortOrder       Float       @default(0)
  isPublished     Boolean     @default(true)
  createdAt       Timestamptz @default(now())
  updatedAt       Timestamptz @default(now())

  @@rls
  @@map("product")
}

model ProductSize {
  id        Int @id @default(autoincrement())
  productId Int
  sizeId    Int

  @@unique([productId, sizeId])
  @@rls
  @@map("product_size")
}

model ProductImage {
  id        Int   @id @default(autoincrement())
  productId Int
  imageUrl  String
  sortOrder Float @default(0)

  @@rls
  @@map("product_image")
}

model ProductRelated {
  id               Int   @id @default(autoincrement())
  productId        Int
  relatedProductId Int
  sortOrder        Float @default(0)

  @@unique([productId, relatedProductId])
  @@rls
  @@map("product_related")
}

model BlogCategory {
  id        Int         @id @default(autoincrement())
  title     String      @unique
  slug      String      @unique
  sortOrder Float       @default(0)
  updatedAt Timestamptz @default(now())

  @@rls
  @@map("blog_category")
}

model BlogPost {
  id              Int         @id @default(autoincrement())
  title           String
  slug            String      @unique
  excerpt         String      @default("")
  content         String      @default("")
  imageUrl        String
  metaTitle       String      @default("")
  metaDescription String      @default("")
  authorName      String      @default("AMA Supplies")
  categoryId      Int
  sortOrder       Float       @default(0)
  isPublished     Boolean     @default(true)
  publishedAt     Timestamptz @default(now())
  createdAt       Timestamptz @default(now())
  updatedAt       Timestamptz @default(now())

  @@rls
  @@map("blog_post")
}

model BlogPostProduct {
  id        Int   @id @default(autoincrement())
  postId    Int
  productId Int
  sortOrder Float @default(0)

  @@unique([postId, productId])
  @@rls
  @@map("blog_post_product")
}
